{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailAnalysis": {
    "Provider": "openai"
  },
  "EmailProcessing": {
    "Enabled": false,
    "MaxConcurrency": 1,
    "MaxAttempts": 3,
    "PollIntervalSeconds": 2,
    "RetryDelaySeconds": 30,
    "LeaseDurationSeconds": 120,
    "RequestTimeoutSeconds": 90,
    "MaxInputCharacters": 40000
  },
  "OpenAI": {
    "Model": "gpt-6-luna",
    "MaxOutputTokenCount": 1200,
    "ModelPricing": {}
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
