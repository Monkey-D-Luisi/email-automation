      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json; return [{ json: { outcome: \"integration-request-failed\", httpStatus: item.statusCode ?? null } }];"
      }
    },
    {
      "id": "report-outlook-claim-status-safely",
      "name": "Report Outlook Claim Status Safely",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2030,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json; const status = Number(response.statusCode ?? 0); return [{ json: { outcome: status === 200 ? \"no-pending-outlook-export\" : \"claim-request-failed\", httpStatus: status || null } }];"
      }
    }
