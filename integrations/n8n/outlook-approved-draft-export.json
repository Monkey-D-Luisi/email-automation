      "position": [
        1590,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.SMARTINBOX_API_ORIGIN + '/api/v1/integrations/outlook/draft-exports/claim'}}",
        "sendHeaders": false,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "outlook-export-claim-available",
      "name": "Outlook Export Claim Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1810,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
