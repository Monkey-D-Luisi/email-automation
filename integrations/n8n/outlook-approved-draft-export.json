        3130,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claim = $(\"Claim Outlook Export\").first().json.body.claim; return [{ json: { exportId: claim.exportId, attemptId: claim.attemptId, failureKind: \"ProviderOutcomeUnknown\" } }];"
      }
    },
