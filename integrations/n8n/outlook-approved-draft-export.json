      "parameters": {
        "method": "POST",
        "url": "={{$env.SMARTINBOX_API_ORIGIN + '/api/v1/integrations/outlook/draft-exports/' + $json.exportId + '/complete'}}",
        "sendHeaders": false,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { attemptId: $json.attemptId, externalDraftId: $json.externalDraftId } }}",
