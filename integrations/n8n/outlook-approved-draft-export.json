    {
      "id": "create-synthetic-outlook-draft-id",
      "name": "Create Synthetic Outlook Draft ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2470,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claim = $input.first().json.body.claim; return [{ json: { claim, externalDraftId: `fake-${claim.exportId}-${claim.attemptId}`, isDraft: true } }];"
      }
    },
    {
      "id": "create-outlook-draft",
      "name": "Create Outlook Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2470,
        250
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "IdType=\"ImmutableId\""
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { subject: $json.body.claim.subject, body: { contentType: \"Text\", content: $json.body.claim.body }, toRecipients: [{ emailAddress: { address: $json.body.claim.recipientEmail } }] } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "validate-outlook-draft-result",
      "name": "Validate Outlook Draft Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2690,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst body = response.body ?? response;\nconst claim = $(\"Claim Outlook Export\").first().json.body.claim;\nconst externalDraftId = typeof body.id === \"string\" ? body.id : null;\nreturn [{ json: { claim, externalDraftId, valid: Number(response.statusCode ?? 0) === 201 && body.isDraft === true && !!externalDraftId } }];"
      }
    },
    {
      "id": "outlook-draft-created",
      "name": "Outlook Draft Created?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2910,
        250
      ],
      "parameters": {
