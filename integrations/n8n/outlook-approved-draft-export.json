    {
      "id": "require-explicit-outlook-export-mode",
      "name": "Require Explicit Outlook Export Mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        230
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const mode = $env.SMARTINBOX_OUTLOOK_MODE || \"disabled\";\nif (mode === \"disabled\") return [];\nif (![\"fake\", \"fake-ambiguous\", \"live\"].includes(mode)) throw new Error(\"Set SMARTINBOX_OUTLOOK_MODE to disabled, fake, fake-ambiguous, or live.\");\nif (mode === \"live\" && !($env.SMARTINBOX_OUTLOOK_MAILBOX_ID || \"\").trim()) throw new Error(\"Configure the authorized Outlook mailbox identity.\");\nreturn [{ json: { mode } }];"
      }
    },
    {
      "id": "use-live-outlook-graph",
      "name": "Use Live Outlook Graph?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        230
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "use-live-outlook-graph-condition",
              "leftValue": "={{$json.mode === \"live\"}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "verify-outlook-export-mailbox",
      "name": "Verify Outlook Export Mailbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        120
      ],
      "parameters": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me?$select=mail,userPrincipalName",
        "sendHeaders": false,
        "sendBody": false,
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "confirm-outlook-export-identity",
      "name": "Confirm Outlook Export Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst body = response.body ?? response;\nconst expected = String($env.SMARTINBOX_OUTLOOK_MAILBOX_ID || \"\").trim().toLowerCase();\nconst actual = String(body.mail || body.userPrincipalName || \"\").trim().toLowerCase();\nconst mode = $(\"Require Explicit Outlook Export Mode\").first().json.mode;\nreturn [{ json: { identityVerified: Number(response.statusCode ?? 200) === 200 && !!expected && actual === expected, reason: actual === expected ? null : \"mailbox-identity-mismatch\", mode } }];"
      }
    },
    {
      "id": "outlook-export-identity-matches",
      "name": "Outlook Export Identity Matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1360,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "outlook-export-identity-matches-condition",
              "leftValue": "={{$json.identityVerified === true}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "safe-outlook-export-identity-diagnostic",
      "name": "Safe Outlook Export Identity Diagnostic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1590,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { outcome: \"mailbox-identity-not-verified\" } }];"
      }
    },
    {
      "id": "safe-outlook-identity-request-diagnostic",
      "name": "Safe Outlook Identity Request Diagnostic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        380
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { outcome: \"mailbox-identity-request-failed\" } }];"
      }
    },
