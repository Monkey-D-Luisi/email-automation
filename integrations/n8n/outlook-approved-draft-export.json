            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "use-fake-outlook-draft-adapter-condition",
              "leftValue": "={{$env.SMARTINBOX_OUTLOOK_MODE === \"fake\" || $env.SMARTINBOX_OUTLOOK_MODE === \"fake-ambiguous\"}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
